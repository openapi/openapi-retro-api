# ─────────────────────────────────────────────────────────────
#  Retro-API .gitignore
#  C:\> TYPE .GITIGNORE
# ─────────────────────────────────────────────────────────────

# 🔐 Segreti: le API key non devono MAI finire nella repo
.env
.env.*
!.env.example
*.key
*.pem
secrets.*
token.txt
TOKEN.TXT
APIKEY.TXT

# 💻 IDE ed editor
.idea/
.vscode/
*.swp
*.swo
*~

# 🗂️ File di sistema (moderni e meno moderni)
.DS_Store
._*
Thumbs.db
desktop.ini
.AppleDouble
.Trashes
.info
*.info.bak

# 🧪 Emulatori: stati salvati, config locali e log
*.sav
*.state
*.st0
*.st1
*.vsf
*.uss
dosbox*.conf
86box.cfg
*.log

# 🔨 Artefatti di compilazione
*.o
*.obj
*.OBJ
*.map
*.MAP
*.tmp
*.TMP
*.bak
*.BAK
build/
dist/

# 🌉 Bridge e proxy moderni (Node, Python, PlatformIO...)
node_modules/
__pycache__/
*.pyc
.venv/
.pio/

# 💾 Non ignorare mai .p101/ : le cartoline magnetiche vanno conservate
